# Maintainer: yindle contributors <yindle@example.invalid>
pkgname=yindle
pkgver=0.1.0
pkgrel=0
pkgdesc="Memory-safe CUPS-compatible print spooler and IPP scheduler"
url="https://example.invalid/yindle"
arch="all"
license="MIT OR Apache-2.0"
depends="avahi"
makedepends="cargo rust avahi-dev"
provides="cups"
install="$pkgname.pre-install"
subpackages="$pkgname-doc $pkgname-openrc"
source="$pkgname-$pkgver.tar.gz"

build() {
    cargo build --workspace --release --frozen
}

package() {
    make install DESTDIR="$pkgdir" PROFILE=release USER=lp GROUP=lp
    install -Dm644 packaging/alpine/yindle.initd \
        "$pkgdir/etc/init.d/yindle"
    install -Dm644 packaging/pam/cups "$pkgdir/etc/pam.d/cups"
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/MIT"
    install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/Apache-2.0"
}

sha512sums="SKIP"
