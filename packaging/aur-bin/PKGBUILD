# Maintainer: vindeckyy <https://github.com/vindeckyy>
pkgname=yindle-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="Memory-safe CUPS 2.x-compatible print spooler and IPP scheduler in Rust (prebuilt release binaries)"
arch=('x86_64')
url="https://github.com/vindeckyy/yindle"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
provides=('cups' 'yindle')
conflicts=('cups' 'yindle')
backup=('etc/cups/cupsd.conf' 'etc/cups/cups-files.conf' 'etc/cups/printers.conf')
install=
source=("https://github.com/vindeckyy/yindle/releases/download/v${pkgver}/yindle-${pkgver}-x86_64-unknown-linux-gnu.tar.gz"
        "yindle.sysusers"
        "yindle.tmpfiles")
sha256sums=('daa9fc8ecb9815b5909abad4be36b7faa177d35cd03d373aa8c54bc26bdad4fb'
            'SKIP'
            'SKIP')

package() {
    cd "yindle-${pkgver}"

    # The release tarball is an FHS tree; package the persistent parts.
    # Runtime dirs are created by the shipped tmpfiles config instead.
    cp -a usr etc "$pkgdir/"

    install -Dm644 "$srcdir/yindle.sysusers" \
        "$pkgdir/usr/lib/sysusers.d/yindle.conf"
    install -Dm644 "$srcdir/yindle.tmpfiles" \
        "$pkgdir/usr/lib/tmpfiles.d/yindle.conf"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/MIT"
    install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/Apache-2.0"
}
